<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.irytour.reservation-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/psh/Library/Application Support/irytour/sync-reservations.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/psh/Documents/iryAssistant</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/psh/Library/Logs/irytour/reservation-sync.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/psh/Library/Logs/irytour/reservation-sync.err.log</string>
</dict>
</plist>
